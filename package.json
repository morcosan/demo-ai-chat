{
	"name": "demo-ai-chat",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"app--local": "cross-env NODE_ENV=app-local vite",
		"app--build-dev": "tsc -b && cross-env NODE_ENV=app-dev vite build",
		"app--build-alpha": "tsc -b && cross-env NODE_ENV=app-alpha vite build",
		"app--build-beta": "tsc -b && cross-env NODE_ENV=app-beta vite build",
		"app--build-prod": "tsc -b && cross-env NODE_ENV=app-prod vite build",
		"app--preview": "vite preview",
		"ds--local": "cross-env NODE_ENV=ds-local storybook dev --no-open -p 9000",
		"ds--build-dev": "cross-env NODE_ENV=ds-dev storybook build -o __dist-ds",
		"ds--build-prod": "cross-env NODE_ENV=ds-prod storybook build -o __dist-ds",
		"ds--preview": "vite preview --config .storybook/vite.config.ts",
		"lint": "eslint .",
		"lint-fix": "eslint . --fix",
		"lint-typescript": "tsc -b",
		"clear-cache": "rmdir /s /q \"node_modules/.cache\"",
		"uninstall": "rmdir /s /q \"node_modules\""
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.32.1",
		"@emotion/cache": "^11.14.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.0",
		"@mantine/core": "^7.15.1",
		"@mui/lab": "^6.0.0-beta.19",
		"@mui/material": "^6.2.0",
		"antd": "^5.22.4",
		"clsx": "^2.1.1",
		"dompurify": "^3.2.3",
		"events": "^3.3.0",
		"highlight.js": "^11.10.0",
		"i18next": "^24.1.0",
		"i18next-browser-languagedetector": "^8.0.2",
		"lodash": "^4.17.21",
		"marked": "^15.0.3",
		"marked-highlight": "^2.2.1",
		"openai": "^4.76.3",
		"prettier": "^3.4.2",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-i18next": "^15.2.0",
		"react-router-dom": "^7.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@faker-js/faker": "^9.3.0",
		"@storybook/addon-a11y": "^8.4.7",
		"@storybook/addon-essentials": "^8.4.7",
		"@storybook/addon-toolbars": "^8.4.7",
		"@storybook/react-vite": "^8.4.7",
		"@storybook/theming": "^8.4.7",
		"@types/lodash": "^4.17.13",
		"@types/node": "^22.10.2",
		"@types/react": "^19.0.1",
		"@types/react-dom": "^19.0.2",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"cross-env": "^7.0.3",
		"dotenv-flow": "^4.1.0",
		"eslint": "^9.17.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.1.0",
		"eslint-plugin-react-refresh": "^0.4.16",
		"globals": "^15.13.0",
		"postcss": "^8.4.49",
		"postcss-import": "^16.1.0",
		"prettier-plugin-css-order": "^2.1.2",
		"prettier-plugin-organize-imports": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.6.9",
		"storybook": "^8.4.7",
		"tailwindcss": "^3.4.16",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.0",
		"vite": "^6.0.3",
		"vite-plugin-svgr": "^4.3.0"
	}
}
